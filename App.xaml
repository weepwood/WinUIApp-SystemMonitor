<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WinUIApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIApp"
    xmlns:controls="using:WinUIApp.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Fluent 2 调色板。每个指标都有自己的强调色，并随浅色/深色主题切换；
                Default 字典作为未知主题的回退值，HighContrast 使用系统高对比链接色。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="CpuAccentColor">#FF60CDFF</Color>
                    <Color x:Key="MemoryAccentColor">#FF57D9A3</Color>
                    <Color x:Key="DiskAccentColor">#FFFFC160</Color>
                    <Color x:Key="NetworkAccentColor">#FFC0A8FF</Color>
                    <SolidColorBrush x:Key="CpuAccentBrush" Color="#FF60CDFF" />
                    <SolidColorBrush x:Key="MemoryAccentBrush" Color="#FF57D9A3" />
                    <SolidColorBrush x:Key="DiskAccentBrush" Color="#FFFFC160" />
                    <SolidColorBrush x:Key="NetworkAccentBrush" Color="#FFC0A8FF" />
                    <SolidColorBrush x:Key="CpuAccentSubtleBrush" Color="#2660CDFF" />
                    <SolidColorBrush x:Key="MemoryAccentSubtleBrush" Color="#2657D9A3" />
                    <SolidColorBrush x:Key="DiskAccentSubtleBrush" Color="#26FFC160" />
                    <SolidColorBrush x:Key="NetworkAccentSubtleBrush" Color="#26C0A8FF" />
                    <SolidColorBrush x:Key="NavHeaderBackgroundBrush" Color="#14000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="CpuAccentColor">#FF0067B8</Color>
                    <Color x:Key="MemoryAccentColor">#FF0F7B5F</Color>
                    <Color x:Key="DiskAccentColor">#FF9A5B00</Color>
                    <Color x:Key="NetworkAccentColor">#FF6B4BB8</Color>
                    <SolidColorBrush x:Key="CpuAccentBrush" Color="#FF0067B8" />
                    <SolidColorBrush x:Key="MemoryAccentBrush" Color="#FF0F7B5F" />
                    <SolidColorBrush x:Key="DiskAccentBrush" Color="#FF9A5B00" />
                    <SolidColorBrush x:Key="NetworkAccentBrush" Color="#FF6B4BB8" />
                    <SolidColorBrush x:Key="CpuAccentSubtleBrush" Color="#1A0067B8" />
                    <SolidColorBrush x:Key="MemoryAccentSubtleBrush" Color="#1A0F7B5F" />
                    <SolidColorBrush x:Key="DiskAccentSubtleBrush" Color="#1A9A5B00" />
                    <SolidColorBrush x:Key="NetworkAccentSubtleBrush" Color="#1A6B4BB8" />
                    <SolidColorBrush x:Key="NavHeaderBackgroundBrush" Color="#0A000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="CpuAccentColor">#FF60CDFF</Color>
                    <Color x:Key="MemoryAccentColor">#FF57D9A3</Color>
                    <Color x:Key="DiskAccentColor">#FFFFC160</Color>
                    <Color x:Key="NetworkAccentColor">#FFC0A8FF</Color>
                    <SolidColorBrush x:Key="CpuAccentBrush" Color="#FF60CDFF" />
                    <SolidColorBrush x:Key="MemoryAccentBrush" Color="#FF57D9A3" />
                    <SolidColorBrush x:Key="DiskAccentBrush" Color="#FFFFC160" />
                    <SolidColorBrush x:Key="NetworkAccentBrush" Color="#FFC0A8FF" />
                    <SolidColorBrush x:Key="CpuAccentSubtleBrush" Color="#2660CDFF" />
                    <SolidColorBrush x:Key="MemoryAccentSubtleBrush" Color="#2657D9A3" />
                    <SolidColorBrush x:Key="DiskAccentSubtleBrush" Color="#26FFC160" />
                    <SolidColorBrush x:Key="NetworkAccentSubtleBrush" Color="#26C0A8FF" />
                    <SolidColorBrush x:Key="NavHeaderBackgroundBrush" Color="#14000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Color x:Key="CpuAccentColor">#FF1AEBFF</Color>
                    <Color x:Key="MemoryAccentColor">#FF1AEBFF</Color>
                    <Color x:Key="DiskAccentColor">#FF1AEBFF</Color>
                    <Color x:Key="NetworkAccentColor">#FF1AEBFF</Color>
                    <SolidColorBrush x:Key="CpuAccentBrush" Color="#FF1AEBFF" />
                    <SolidColorBrush x:Key="MemoryAccentBrush" Color="#FF1AEBFF" />
                    <SolidColorBrush x:Key="DiskAccentBrush" Color="#FF1AEBFF" />
                    <SolidColorBrush x:Key="NetworkAccentBrush" Color="#FF1AEBFF" />
                    <SolidColorBrush x:Key="CpuAccentSubtleBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="MemoryAccentSubtleBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="DiskAccentSubtleBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NetworkAccentSubtleBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavHeaderBackgroundBrush" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ============ 卡片 ============ -->
            <Style x:Key="MonitorCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="NestedCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <!-- ============ 排版 ============ -->
            <Style x:Key="SectionHeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MetricValueTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="IsTextScaleFactorEnabled" Value="True" />
            </Style>

            <Style x:Key="MetricUnitTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- ============ 页面标题 ============ -->
            <Style x:Key="PageHeaderStyle" TargetType="controls:PageHeader">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:PageHeader">
                            <Grid x:Name="HeaderGrid" Padding="{TemplateBinding Padding}"
                                  ColumnSpacing="16" RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="0" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Eyebrow}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{TemplateBinding Title}"
                                               Style="{StaticResource TitleTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{TemplateBinding Subtitle}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ContentPresenter x:Name="HeaderActions" Grid.Column="1"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 设置卡 ============ -->
            <Style x:Key="SettingsCardStyle" TargetType="controls:SettingsCard">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:SettingsCard">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid x:Name="SettingsCardLayout" ColumnSpacing="14" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="0" />
                                    </Grid.RowDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <FontIcon Glyph="{TemplateBinding Icon}" FontSize="16"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding Header}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{TemplateBinding Description}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ContentPresenter x:Name="SettingsCardContent" Grid.Column="2"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 信息行 ============ -->
            <Style x:Key="InfoRowStyle" TargetType="controls:InfoRow">
                <Setter Property="Padding" Value="0,5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:InfoRow">
                            <Grid x:Name="InfoRowLayout" ColumnSpacing="16" Padding="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="InfoRowLabel" Text="{TemplateBinding Label}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Top" Margin="0,1,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="InfoRowValue" Grid.Column="1"
                                           Text="{TemplateBinding Value}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 指标磁贴 ============ -->
            <Style x:Key="StatTileStyle" TargetType="controls:StatTile">
                <Setter Property="Padding" Value="12" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:StatTile">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{TemplateBinding Label}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{TemplateBinding Value}"
                                               FontSize="18" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
