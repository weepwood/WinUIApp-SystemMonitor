<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIApp.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinUIApp.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <TextBlock Text="网络详细监测" Style="{StaticResource TitleTextBlockStyle}" />

            <ItemsControl ItemsSource="{Binding Network.Adapters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NetworkItemViewModel">
                        <Border Style="{StaticResource MonitorCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- 适配器名称和状态 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding IpAddresses}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="状态" FontSize="9"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Status}" FontSize="11"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <!-- 流量统计 -->
                                <Grid Margin="0,12,0,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 下载 -->
                                    <Border Grid.Column="0" CornerRadius="6" Padding="10"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="下载" FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding DownloadSpeedText}" FontSize="16"
                                                       FontWeight="SemiBold" Foreground="#FF107C10"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 上传 -->
                                    <Border Grid.Column="1" CornerRadius="6" Padding="10"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="上传" FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding UploadSpeedText}" FontSize="16"
                                                       FontWeight="SemiBold" Foreground="#FFD83B01"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
