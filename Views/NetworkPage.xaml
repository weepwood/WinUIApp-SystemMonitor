<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIApp.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIApp.Controls"
    xmlns:vm="using:WinUIApp.ViewModels">

    <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="ContentPanel" Padding="24,8,24,32" Spacing="16"
                    MaxWidth="1400" HorizontalAlignment="Stretch">

            <controls:PageHeader Style="{StaticResource PageHeaderStyle}" Eyebrow="硬件 · 网络" Title="网络"
                                 Subtitle="网卡状态、地址信息与实时上下行速率">
                <controls:PageHeader.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="12" VerticalAlignment="Center"
                                      Foreground="{ThemeResource NetworkAccentBrush}" />
                            <TextBlock Text="{Binding Network.DownloadFullText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource NetworkAccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Click="OnRefreshClicked" ToolTipService.ToolTip="立即刷新 (F5)"
                                AutomationProperties.Name="立即刷新监测数据">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:PageHeader.Content>
            </controls:PageHeader>

            <!-- 汇总 -->
            <Border Style="{StaticResource MonitorCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="实时吞吐" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding Network.ActiveAdapterText}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <controls:ResponsivePanel MinItemWidth="140" MaxColumns="3" HorizontalSpacing="8"
                                              VerticalSpacing="8">
                        <controls:StatTile Style="{StaticResource StatTileStyle}" Label="总下载" Value="{Binding Network.DownloadFullText}" />
                        <controls:StatTile Style="{StaticResource StatTileStyle}" Label="总上传" Value="{Binding Network.UploadText}" />
                        <controls:StatTile Style="{StaticResource StatTileStyle}" Label="网卡" Value="{Binding Network.ActiveAdapterText}" />
                    </controls:ResponsivePanel>
                </StackPanel>
            </Border>

            <!-- 网卡列表 -->
            <ItemsControl ItemsSource="{Binding Network.Adapters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NetworkItemViewModel">
                        <Border Style="{StaticResource MonitorCardStyle}" Margin="0,0,0,12">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8"
                                            Background="{ThemeResource NetworkAccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE774;" FontSize="16" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource NetworkAccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding IpAddresses}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="12" Padding="10,4"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <controls:ResponsivePanel MinItemWidth="140" MaxColumns="2" HorizontalSpacing="8"
                                                          VerticalSpacing="8">
                                    <Border Style="{StaticResource NestedCardStyle}">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE896;" FontSize="11" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource NetworkAccentBrush}" />
                                                <TextBlock Text="下载" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DownloadAmountText}" FontSize="18"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource NestedCardStyle}">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE898;" FontSize="11" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource NetworkAccentBrush}" />
                                                <TextBlock Text="上传" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding UploadAmountText}" FontSize="18"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </controls:ResponsivePanel>

                                <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="MAC 地址" Value="{Binding MacAddress}" Padding="0,2" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="速率取自网卡累计字节数的差值，单位为十进制 Mbps；首次采样没有基线时显示为零。"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

        </StackPanel>
    </ScrollViewer>
</Page>
