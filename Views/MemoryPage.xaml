<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIApp.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIApp.Controls">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="MemoryLayout">
                <VisualState x:Name="MemoryWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="GaugeCard.(Grid.Row)" Value="0" />
                        <Setter Target="GaugeCard.(Grid.Column)" Value="0" />
                        <Setter Target="GaugeCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="DetailCard.(Grid.Row)" Value="0" />
                        <Setter Target="DetailCard.(Grid.Column)" Value="1" />
                        <Setter Target="DetailCard.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MemoryNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="GaugeCard.(Grid.Row)" Value="0" />
                        <Setter Target="GaugeCard.(Grid.Column)" Value="0" />
                        <Setter Target="GaugeCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DetailCard.(Grid.Row)" Value="2" />
                        <Setter Target="DetailCard.(Grid.Column)" Value="0" />
                        <Setter Target="DetailCard.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Padding="24,8,24,32" Spacing="16" MaxWidth="1240" HorizontalAlignment="Center">

                <controls:PageHeader Style="{StaticResource PageHeaderStyle}" Eyebrow="硬件 · 内存" Title="内存"
                                     Subtitle="{Binding Memory.AvailableOfTotalText}">
                    <controls:PageHeader.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Memory.UsageText}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource MemoryAccentBrush}" VerticalAlignment="Center" />
                            <Button Click="OnRefreshClicked" ToolTipService.ToolTip="立即刷新 (F5)"
                                    AutomationProperties.Name="立即刷新监测数据">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </controls:PageHeader.Content>
                </controls:PageHeader>

                <Grid ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 使用率环 -->
                    <Border x:Name="GaugeCard" Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource MonitorCardStyle}" Margin="0,0,0,12">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="物理内存使用率" Style="{StaticResource SectionHeaderTextBlockStyle}"
                                       HorizontalAlignment="Center" />
                            <controls:ArcGauge Height="210" Width="210"
                                               Percent="{Binding Memory.UsagePercent}"
                                               Value="{Binding Memory.UsageText}"
                                               Caption="已使用"
                                               GaugeColor="{ThemeResource MemoryAccentColor}"
                                               StrokeWidth="16"
                                               AutomationProperties.Name="物理内存使用率仪表" />
                            <TextBlock Text="{Binding Memory.AvailableOfTotalText}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 明细 -->
                    <Border x:Name="DetailCard" Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource MonitorCardStyle}" Margin="0,0,0,12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="内存明细" Style="{StaticResource SectionHeaderTextBlockStyle}"
                                       Margin="0,0,0,6" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="总内存" Value="{Binding Memory.TotalText}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="已用" Value="{Binding Memory.UsedText}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="可用" Value="{Binding Memory.AvailableText}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="已提交" Value="{Binding Memory.CommittedText}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="缓存" Value="{Binding Memory.CachedText}" />
                            <ProgressBar Value="{Binding Memory.UsagePercent}" Maximum="100"
                                         Height="6" CornerRadius="3" Margin="0,8,0,2"
                                         Foreground="{ThemeResource MemoryAccentBrush}" />
                            <TextBlock Text="已用比例包含系统缓存之外的活动内存。"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 趋势 -->
                <Border Style="{StaticResource MonitorCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="使用率趋势" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding Memory.History.Summary}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <controls:UsageHistoryChart Height="180"
                                                    Data="{Binding Memory.History.Samples}"
                                                    AccentColor="{ThemeResource MemoryAccentColor}"
                                                    ShowGridLines="{Binding Charts.ShowChartGrid}"
                                                    ShowAreaFill="{Binding Charts.ShowChartArea}"
                                                    ShowThresholdLine="{Binding Charts.ShowThresholdLine}"
                                                    Threshold="{Binding Charts.Threshold}"
                                                    Capacity="{Binding Charts.HistoryCapacity}"
                                                    ShowTooltip="{Binding Charts.ShowTooltip}"
                                                    AutomationProperties.Name="内存使用率趋势图" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:StatTile Style="{StaticResource StatTileStyle}" Label="平均值" Value="{Binding Memory.History.AverageText}" />
                            <controls:StatTile Style="{StaticResource StatTileStyle}" Grid.Column="1" Label="峰值" Value="{Binding Memory.History.PeakText}" />
                            <controls:StatTile Style="{StaticResource StatTileStyle}" Grid.Column="2" Label="已提交" Value="{Binding Memory.CommittedText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 内核内存池 -->
                <Border Style="{StaticResource MonitorCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="内核内存池" Style="{StaticResource SectionHeaderTextBlockStyle}"
                                   Margin="0,0,0,4" />
                        <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="分页池" Value="{Binding Memory.PagedPoolText}" />
                        <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="非分页池" Value="{Binding Memory.NonPagedPoolText}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
