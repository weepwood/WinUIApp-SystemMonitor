<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIApp.Views.DiskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinUIApp.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <TextBlock Text="磁盘详细监测" Style="{StaticResource TitleTextBlockStyle}" />

            <ItemsControl ItemsSource="{Binding Disk.Drives}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiskItemViewModel">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                                CornerRadius="8" Padding="16" Margin="0,0,0,12"
                                BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1">
                            <StackPanel>
                                <!-- 磁盘名称和类型 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding UsagePercentText}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="#FF0078D4" VerticalAlignment="Center" />
                                </Grid>

                                <!-- 使用率进度条 -->
                                <ProgressBar Value="{Binding UsagePercent}" Maximum="100"
                                             Margin="0,8,0,8" Height="6"
                                             Foreground="#FF0078D4" />

                                <!-- 读写速度 -->
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="读取速度" FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiary}" />
                                        <TextBlock Text="{Binding ReadSpeedText}" FontSize="12"
                                                   Foreground="#FF107C10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="写入速度" FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiary}" />
                                        <TextBlock Text="{Binding WriteSpeedText}" FontSize="12"
                                                   Foreground="#FFD83B01" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
