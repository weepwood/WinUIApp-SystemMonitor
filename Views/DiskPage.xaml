<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIApp.Views.DiskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIApp.Controls"
    xmlns:vm="using:WinUIApp.ViewModels">

    <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="ContentPanel" Padding="24,8,24,32" Spacing="16"
                    MaxWidth="1400" HorizontalAlignment="Stretch">

            <controls:PageHeader Style="{StaticResource PageHeaderStyle}" Eyebrow="硬件 · 存储" Title="磁盘"
                                 Subtitle="驱动器容量、可用空间与实时读写速率">
                <controls:PageHeader.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Disk.TotalUsageText}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource DiskAccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="% 已用" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Click="OnRefreshClicked" ToolTipService.ToolTip="立即刷新 (F5)"
                                AutomationProperties.Name="立即刷新监测数据">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </controls:PageHeader.Content>
            </controls:PageHeader>

            <InfoBar IsOpen="{Binding Disk.HasUnavailableSpeeds, Mode=OneWay}"
                     IsClosable="False" Severity="Informational"
                     Title="磁盘实时速率暂不可用"
                     Message="Windows 性能计数器未返回有效数据，当前仅显示容量信息。可检查 WMI 与磁盘性能计数器。" />

            <!-- 汇总 -->
            <Border Style="{StaticResource MonitorCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="存储总览" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding Disk.DriveCountText}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ProgressBar Value="{Binding Disk.TotalUsagePercent}" Maximum="100"
                                 Height="8" CornerRadius="4"
                                 Foreground="{ThemeResource DiskAccentBrush}" />
                    <controls:ResponsivePanel MinItemWidth="120" MaxColumns="3" HorizontalSpacing="8"
                                              VerticalSpacing="8">
                        <controls:StatTile Style="{StaticResource StatTileStyle}" Label="总容量" Value="{Binding Disk.TotalSizeText}" />
                        <controls:StatTile Style="{StaticResource StatTileStyle}" Label="已用" Value="{Binding Disk.TotalUsedText}" />
                        <controls:StatTile Style="{StaticResource StatTileStyle}" Label="剩余" Value="{Binding Disk.TotalFreeText}" />
                    </controls:ResponsivePanel>
                </StackPanel>
            </Border>

            <!-- 驱动器列表 -->
            <ItemsControl ItemsSource="{Binding Disk.Drives}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiskItemViewModel">
                        <Border Style="{StaticResource MonitorCardStyle}" Margin="0,0,0,12">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8"
                                            Background="{ThemeResource DiskAccentSubtleBrush}">
                                        <FontIcon Glyph="&#xEDA2;" FontSize="16" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource DiskAccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding UsagePercentText}"
                                               FontSize="20" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource DiskAccentBrush}" />
                                </Grid>

                                <ProgressBar Value="{Binding UsagePercent}" Maximum="100"
                                             Height="6" CornerRadius="3"
                                             Foreground="{ThemeResource DiskAccentBrush}" />

                                <controls:ResponsivePanel MinItemWidth="150" MaxColumns="3" HorizontalSpacing="8"
                                                          VerticalSpacing="8">
                                    <controls:StatTile Style="{StaticResource StatTileStyle}" Label="已用 / 总容量" Value="{Binding SizeText}" />
                                    <Border Style="{StaticResource NestedCardStyle}">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE896;" FontSize="11"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="读取" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ReadSpeedText}" FontSize="16"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FreeSpaceText}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource NestedCardStyle}">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE898;" FontSize="11"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="写入" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding WriteSpeedText}" FontSize="16"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DriveType}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </controls:ResponsivePanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="读写速率来自 WMI 逻辑磁盘计数器；计数器被禁用时可能一直为零。"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

        </StackPanel>
    </ScrollViewer>
</Page>
