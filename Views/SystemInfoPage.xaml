<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIApp.Views.SystemInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <TextBlock Text="系统信息" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- 操作系统信息 -->
            <Border Style="{StaticResource MonitorCardStyle}">
                <StackPanel>
                    <TextBlock Text="操作系统" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="操作系统" Grid.Row="0" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.OsVersion}" Grid.Row="0" Grid.Column="1" FontSize="12" />

                        <TextBlock Text="版本号" Grid.Row="1" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.OsBuild}" Grid.Row="1" Grid.Column="1" FontSize="12" />

                        <TextBlock Text="计算机名" Grid.Row="2" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.MachineName}" Grid.Row="2" Grid.Column="1" FontSize="12" />

                        <TextBlock Text="运行时间" Grid.Row="3" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.Uptime}" Grid.Row="3" Grid.Column="1" FontSize="12" />

                        <TextBlock Text="安装内存" Grid.Row="4" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12">
                            <Run Text="{Binding SystemInfo.InstalledMemoryGB}" />
                            <Run Text=" GB" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- BIOS / 主板 -->
            <Border Style="{StaticResource MonitorCardStyle}">
                <StackPanel>
                    <TextBlock Text="BIOS 和主板" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="BIOS 厂商" Grid.Row="0" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.BiosManufacturer}" Grid.Row="0" Grid.Column="1" FontSize="12" />

                        <TextBlock Text="BIOS 版本" Grid.Row="1" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.BiosVersion}" Grid.Row="1" Grid.Column="1" FontSize="12" />

                        <TextBlock Text="主板厂商" Grid.Row="2" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.MotherboardManufacturer}" Grid.Row="2" Grid.Column="1" FontSize="12" />

                        <TextBlock Text="主板型号" Grid.Row="3" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.MotherboardProduct}" Grid.Row="3" Grid.Column="1" FontSize="12" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MonitorCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="内存占用前 5 的进程" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="按当前工作集排序 · 仅显示可读取的进程" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding SystemInfo.TopProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,5" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"><Run Text="PID " /><Run Text="{Binding Id}" /></TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 系统统计 -->
            <Border Style="{StaticResource MonitorCardStyle}">
                <StackPanel>
                    <TextBlock Text="系统统计" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="进程数" Grid.Row="0" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.ProcessCount}" Grid.Row="0" Grid.Column="1" FontSize="12" />

                        <TextBlock Text="线程数" Grid.Row="1" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.ThreadCount}" Grid.Row="1" Grid.Column="1" FontSize="12" />

                        <TextBlock Text="句柄数" Grid.Row="2" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.HandleCount}" Grid.Row="2" Grid.Column="1" FontSize="12" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
