<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIApp.Views.SystemInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIApp.Controls"
    xmlns:vm="using:WinUIApp.ViewModels">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="InfoLayout">
                <VisualState x:Name="InfoWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OsCard.(Grid.Row)" Value="0" />
                        <Setter Target="OsCard.(Grid.Column)" Value="0" />
                        <Setter Target="OsCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="FirmwareCard.(Grid.Row)" Value="0" />
                        <Setter Target="FirmwareCard.(Grid.Column)" Value="1" />
                        <Setter Target="FirmwareCard.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="InfoNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OsCard.(Grid.Row)" Value="0" />
                        <Setter Target="OsCard.(Grid.Column)" Value="0" />
                        <Setter Target="OsCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="FirmwareCard.(Grid.Row)" Value="2" />
                        <Setter Target="FirmwareCard.(Grid.Column)" Value="0" />
                        <Setter Target="FirmwareCard.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Padding="24,8,24,32" Spacing="16" MaxWidth="1240" HorizontalAlignment="Center">

                <controls:PageHeader Style="{StaticResource PageHeaderStyle}" Eyebrow="系统" Title="系统信息" Subtitle="{Binding SystemInfo.MachineName}">
                    <controls:PageHeader.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource CpuAccentSubtleBrush}" CornerRadius="14"
                                    Padding="14,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="11" VerticalAlignment="Center"
                                              Foreground="{ThemeResource CpuAccentBrush}" />
                                    <TextBlock Text="{Binding SystemInfo.InstalledMemoryText}" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{ThemeResource CpuAccentBrush}" />
                                </StackPanel>
                            </Border>
                            <Button Click="OnRefreshClicked" ToolTipService.ToolTip="立即刷新 (F5)"
                                    AutomationProperties.Name="立即刷新监测数据">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </controls:PageHeader.Content>
                </controls:PageHeader>

                <Grid ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="OsCard" Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource MonitorCardStyle}" Margin="0,0,0,12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="操作系统" Style="{StaticResource SectionHeaderTextBlockStyle}"
                                       Margin="0,0,0,4" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="计算机名" Value="{Binding SystemInfo.MachineName}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="操作系统" Value="{Binding SystemInfo.OsVersion}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="版本号" Value="{Binding SystemInfo.OsBuild}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="安装内存" Value="{Binding SystemInfo.InstalledMemoryText}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="运行时间" Value="{Binding SystemInfo.Uptime}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="电源状态" Value="{Binding Power.Summary}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="FirmwareCard" Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource MonitorCardStyle}" Margin="0,0,0,12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="固件、主板与显卡" Style="{StaticResource SectionHeaderTextBlockStyle}"
                                       Margin="0,0,0,4" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="BIOS 厂商" Value="{Binding SystemInfo.BiosManufacturer}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="BIOS 版本" Value="{Binding SystemInfo.BiosVersion}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="主板厂商" Value="{Binding SystemInfo.MotherboardManufacturer}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="主板型号" Value="{Binding SystemInfo.MotherboardProduct}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="显卡" Value="{Binding SystemInfo.GraphicsName}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="显卡驱动" Value="{Binding SystemInfo.GraphicsDriver}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource MonitorCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="系统统计" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:StatTile Style="{StaticResource StatTileStyle}" Label="进程数" Value="{Binding SystemInfo.ProcessCountText}" />
                            <controls:StatTile Style="{StaticResource StatTileStyle}" Grid.Column="1" Label="线程数" Value="{Binding SystemInfo.ThreadCountText}" />
                            <controls:StatTile Style="{StaticResource StatTileStyle}" Grid.Column="2" Label="句柄数" Value="{Binding SystemInfo.HandleCountText}" />
                            <controls:StatTile Style="{StaticResource StatTileStyle}" Grid.Column="3" Label="运行时间" Value="{Binding SystemInfo.Uptime}" />
                        </Grid>
                        <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="本应用开销"
                                          Value="{Binding SystemInfo.SelfOverheadText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MonitorCardStyle}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SystemInfo.TopProcessesTitle}"
                                       Style="{StaticResource SectionHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="按工作集排序"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SystemInfo.TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProcessRowViewModel">
                                    <Grid ColumnSpacing="12" Padding="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RankText}" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                <Run Text="PID " /><Run Text="{Binding Id}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <ProgressBar Grid.Column="2" Value="{Binding SharePercent}" Maximum="100"
                                                     Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                     Foreground="{ThemeResource CpuAccentBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   MinWidth="70" TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="仅显示可读取工作集的进程。"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
