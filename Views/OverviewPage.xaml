<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIApp.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIApp.Controls"
    xmlns:vm="using:WinUIApp.ViewModels">

    <Grid>

        <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel x:Name="ContentPanel" Padding="24,8,24,32" Spacing="16"
                        MaxWidth="1400" HorizontalAlignment="Stretch">

                <controls:PageHeader Style="{StaticResource PageHeaderStyle}" Eyebrow="本机监测" Title="性能总览" Subtitle="{Binding OverviewSubtitle}">
                    <controls:PageHeader.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnRefreshClicked" ToolTipService.ToolTip="立即刷新 (F5)"
                                    AutomationProperties.Name="立即刷新监测数据">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="刷新" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}" Click="OnCopySummary"
                                    IsEnabled="{Binding HasSample}"
                                    ToolTipService.ToolTip="复制当前监测数据"
                                    AutomationProperties.Name="复制当前监测摘要">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock Text="复制摘要" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:PageHeader.Content>
                </controls:PageHeader>

                <InfoBar x:Name="CopyFeedback" IsOpen="False" IsClosable="True" />

                <!-- 四个关键指标：按可用宽度自动 4 / 2 / 1 列，不再依赖窗口宽度断点 -->
                <controls:ResponsivePanel MinItemWidth="260" MaxColumns="4" PreferEvenColumns="True"
                                          HorizontalSpacing="12" VerticalSpacing="12">

                    <!-- CPU -->
                    <Border x:Name="CpuMetricCard"
                            Style="{StaticResource MonitorCardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8"
                                        Background="{ThemeResource CpuAccentSubtleBrush}">
                                    <FontIcon Glyph="&#xE950;" FontSize="14" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Foreground="{ThemeResource CpuAccentBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="处理器" VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding Cpu.ClockSpeedText}" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Cpu.UsageValueText}" Style="{StaticResource MetricValueTextBlockStyle}" />
                                <TextBlock Text="%" Style="{StaticResource MetricUnitTextBlockStyle}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            </StackPanel>
                            <controls:UsageHistoryChart Height="56"
                                                        Data="{Binding Cpu.History.Samples}"
                                                        AccentColor="{ThemeResource CpuAccentColor}"
                                                        ShowGridLines="False"
                                                        ShowAreaFill="{Binding Charts.ShowChartArea}"
                                                        Capacity="{Binding Charts.HistoryCapacity}"
                                                        ShowTooltip="{Binding Charts.ShowTooltip}"
                                                        AutomationProperties.Name="处理器使用率趋势" />
                            <TextBlock Text="{Binding Cpu.History.SummaryShort}" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 内存 -->
                    <Border x:Name="MemoryMetricCard"
                            Style="{StaticResource MonitorCardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8"
                                        Background="{ThemeResource MemoryAccentSubtleBrush}">
                                    <FontIcon Glyph="&#xE9D2;" FontSize="14" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Foreground="{ThemeResource MemoryAccentBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="物理内存" VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding Memory.TotalText}" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Memory.UsageValueText}" Style="{StaticResource MetricValueTextBlockStyle}" />
                                <TextBlock Text="%" Style="{StaticResource MetricUnitTextBlockStyle}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            </StackPanel>
                            <controls:UsageHistoryChart Height="56"
                                                        Data="{Binding Memory.History.Samples}"
                                                        AccentColor="{ThemeResource MemoryAccentColor}"
                                                        ShowGridLines="False"
                                                        ShowAreaFill="{Binding Charts.ShowChartArea}"
                                                        Capacity="{Binding Charts.HistoryCapacity}"
                                                        ShowTooltip="{Binding Charts.ShowTooltip}"
                                                        AutomationProperties.Name="物理内存使用率趋势" />
                            <TextBlock TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                <Run Text="可用 " /><Run Text="{Binding Memory.AvailableText}" /><Run Text=" / " /><Run Text="{Binding Memory.TotalText}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 存储 -->
                    <Border x:Name="StorageMetricCard"
                            Style="{StaticResource MonitorCardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8"
                                        Background="{ThemeResource DiskAccentSubtleBrush}">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="14" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Foreground="{ThemeResource DiskAccentBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="存储" VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding Disk.DriveCountText}" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Disk.TotalUsageText}" Style="{StaticResource MetricValueTextBlockStyle}" />
                                <TextBlock Text="%" Style="{StaticResource MetricUnitTextBlockStyle}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            </StackPanel>
                            <Grid VerticalAlignment="Center" Height="56">
                                <StackPanel VerticalAlignment="Center" Spacing="10">
                                    <ProgressBar Value="{Binding Disk.TotalUsagePercent}" Maximum="100"
                                                 Height="6" CornerRadius="3"
                                                 Foreground="{ThemeResource DiskAccentBrush}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="剩余 " /><Run Text="{Binding Disk.TotalFreeText}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <TextBlock TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                <Run Text="已用 " /><Run Text="{Binding Disk.TotalUsedText}" /><Run Text=" / " /><Run Text="{Binding Disk.TotalSizeText}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 网络 -->
                    <Border x:Name="NetworkMetricCard"
                            Style="{StaticResource MonitorCardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8"
                                        Background="{ThemeResource NetworkAccentSubtleBrush}">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Foreground="{ThemeResource NetworkAccentBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="网络" VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding Network.AdapterCountText}" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                           MaxWidth="120" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock Text="{Binding Network.DownloadValueText}" Style="{StaticResource MetricValueTextBlockStyle}" />
                                <TextBlock Text="{Binding Network.DownloadUnitText}" Style="{StaticResource MetricUnitTextBlockStyle}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            </StackPanel>
                            <Grid VerticalAlignment="Center" Height="56">
                                <StackPanel VerticalAlignment="Center" Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE896;" FontSize="12"
                                                  Foreground="{ThemeResource NetworkAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Network.UploadText}" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="上传速率" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                <Run Text="{Binding Network.PrimaryAdapterText}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </controls:ResponsivePanel>

                <!-- 设备与驱动器：宽屏并排，窄屏堆叠 -->
                <controls:ResponsivePanel MinItemWidth="340" MaxColumns="2"
                                          HorizontalSpacing="12" VerticalSpacing="12">

                    <Border x:Name="DeviceCard"
                            Style="{StaticResource MonitorCardStyle}">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xE7F8;" FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="设备概况" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                            </StackPanel>
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="计算机名" Value="{Binding SystemInfo.MachineName}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="操作系统" Value="{Binding SystemInfo.OsVersion}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="系统版本" Value="{Binding SystemInfo.OsBuild}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="运行时间" Value="{Binding SystemInfo.Uptime}" />
                            <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="进程 / 线程" Value="{Binding SystemInfo.ProcessThreadSummary}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="DrivesCard"
                            Style="{StaticResource MonitorCardStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xEDA2;" FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="驱动器容量" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Disk.Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiskItemViewModel">
                                        <StackPanel Spacing="4" Padding="0,6">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding UsagePercentText}"
                                                           FontSize="12" FontWeight="SemiBold" />
                                            </Grid>
                                            <ProgressBar Value="{Binding UsagePercent}" Maximum="100"
                                                         Height="4" CornerRadius="2"
                                                         Foreground="{ThemeResource DiskAccentBrush}" />
                                            <TextBlock Text="{Binding FreeSpaceText}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </controls:ResponsivePanel>

                <!-- 网络适配器 -->
                <Border Style="{StaticResource MonitorCardStyle}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="12" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE774;" FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="网络适配器" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Network.ActiveAdapterText}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Network.Adapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NetworkItemViewModel">
                                    <Grid ColumnSpacing="16" Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding IpAddresses}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DownloadAmountText}" FontSize="12"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="下载" FontSize="10" HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right" MinWidth="72">
                                            <TextBlock Text="{Binding UploadAmountText}" FontSize="12"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="上传" FontSize="10" HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
