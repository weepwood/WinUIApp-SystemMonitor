<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIApp.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIApp.Controls"
    xmlns:vm="using:WinUIApp.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <!-- 标题 -->
            <TextBlock Text="系统概览" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <!-- CPU + 内存仪表盘行 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU 仪表盘 -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="8" Padding="16"
                        BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CPU 使用率" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
                        <controls:ArcGauge
                            Height="180"
                            Percent="{Binding Cpu.UsagePercent}"
                            Title="CPU"
                            Subtitle="{Binding Cpu.UsageText}"
                            GaugeColor="#FF0078D4" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}">
                            <Run Text="{Binding Cpu.Name}" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiary}">
                            <Run Text="{Binding Cpu.ClockSpeedText}" />
                            <Run Text=" | " />
                            <Run Text="{Binding Cpu.LogicalProcessorCount}" />
                            <Run Text=" 逻辑处理器" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 内存仪表盘 -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="8" Padding="16"
                        BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="内存使用率" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
                        <controls:ArcGauge
                            Height="180"
                            Percent="{Binding Memory.UsagePercent}"
                            Title="内存"
                            Subtitle="{Binding Memory.UsageText}"
                            GaugeColor="#FF107C10" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}">
                            <Run Text="已用 " />
                            <Run Text="{Binding Memory.UsedGB}" />
                            <Run Text=" GB / " />
                            <Run Text="{Binding Memory.TotalGB}" />
                            <Run Text=" GB" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiary}">
                            <Run Text="可用: " />
                            <Run Text="{Binding Memory.AvailableText}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 系统信息卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8" Padding="16"
                    BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="系统信息" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    <Grid ColumnSpacing="24" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="操作系统:" Grid.Row="0" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.OsVersion}" Grid.Row="0" Grid.Column="1" FontSize="12" />

                        <TextBlock Text="运行时间:" Grid.Row="0" Grid.Column="2"
                                   Foreground="{ThemeResource TextFillColorSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.Uptime}" Grid.Row="0" Grid.Column="3" FontSize="12" />

                        <TextBlock Text="计算机名:" Grid.Row="1" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.MachineName}" Grid.Row="1" Grid.Column="1" FontSize="12" />

                        <TextBlock Text="进程数:" Grid.Row="1" Grid.Column="2"
                                   Foreground="{ThemeResource TextFillColorSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding SystemInfo.ProcessCount}" Grid.Row="1" Grid.Column="3" FontSize="12" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 磁盘概览 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8" Padding="16"
                    BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="磁盘" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Disk.Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiskItemViewModel">
                                <Grid Margin="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Grid.Column="1" Value="{Binding UsagePercent}"
                                                 Maximum="100" VerticalAlignment="Center"
                                                 Foreground="#FF0078D4" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 网络概览 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8" Padding="16"
                    BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="网络" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Network.Adapters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NetworkItemViewModel">
                                <Grid Margin="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding IpAddresses}" FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DownloadSpeedText}" FontSize="11"
                                                   Foreground="#FF107C10" HorizontalAlignment="Right" />
                                        <TextBlock Text="下载" FontSize="9"
                                                   Foreground="{ThemeResource TextFillColorTertiary}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding UploadSpeedText}" FontSize="11"
                                                   Foreground="#FFD83B01" HorizontalAlignment="Right" />
                                        <TextBlock Text="上传" FontSize="9"
                                                   Foreground="{ThemeResource TextFillColorTertiary}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
