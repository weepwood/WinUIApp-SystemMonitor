<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIApp.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIApp.Controls"
    xmlns:vm="using:WinUIApp.ViewModels">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CpuCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="MemoryCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="MemoryCard.(Grid.Column)" Value="1" />
                        <Setter Target="MemoryCard.(Grid.Row)" Value="0" />
                        <Setter Target="MemoryCard.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="16" MaxWidth="1280">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="本机监测" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="性能总览" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="CPU 与内存使用率 · 最近 60 个采样点" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Click="OnCopySummary"
                            IsEnabled="{Binding HasSample}" AutomationProperties.Name="复制当前监测摘要">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" /><TextBlock Text="复制摘要" />
                        </StackPanel>
                    </Button>
                </Grid>
                <InfoBar x:Name="CopyFeedback" IsOpen="False" />
                <Grid ColumnSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border x:Name="CpuCard" Grid.ColumnSpan="2" Style="{StaticResource MonitorCardStyle}">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="#397BCF" />
                                <TextBlock Text="处理器" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Cpu.UsageText}" FontSize="36" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Cpu.Name}" />
                            </TextBlock>
                            <controls:UsageHistoryChart Height="116" Data="{Binding Cpu.History.Samples}"
                                                        LineColor="#397BCF" AutomationProperties.Name="处理器使用率趋势" />
                            <TextBlock Text="{Binding Cpu.History.Summary}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="MemoryCard" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource MonitorCardStyle}">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE964;" FontSize="16" Foreground="#138579" />
                                <TextBlock Text="物理内存" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Memory.UsageText}" FontSize="36" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis">
                                <Run Text="可用" /> <Run Text="{Binding Memory.AvailableText}" /> <Run Text=" / " /> <Run Text="{Binding Memory.TotalText}" />
                            </TextBlock>
                            <controls:UsageHistoryChart Height="116" Data="{Binding Memory.History.Samples}"
                                                        LineColor="#138579" AutomationProperties.Name="物理内存使用率趋势" />
                            <TextBlock Text="{Binding Memory.History.Summary}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource MonitorCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="设备概况" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding SystemInfo.MachineName}" /> <Run Text=" · " /> <Run Text="{Binding SystemInfo.OsVersion}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="运行时间" /> <Run Text="{Binding SystemInfo.Uptime}" /> <Run Text=" · " /> <Run Text="进程数" /> <Run Text="{Binding SystemInfo.ProcessCount}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- 磁盘概览 -->
                <Border Style="{StaticResource MonitorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="磁盘" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Disk.Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiskItemViewModel">
                                    <Grid Margin="0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Column="1" Value="{Binding UsagePercent}"
                                                     Maximum="100" VerticalAlignment="Center"
                                                     Foreground="#FF0078D4" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 网络概览 -->
                <Border Style="{StaticResource MonitorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="网络" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Network.Adapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NetworkItemViewModel">
                                    <Grid Margin="0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding IpAddresses}" FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DownloadSpeedText}" FontSize="11"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="下载" FontSize="9"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding UploadSpeedText}" FontSize="11"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="上传" FontSize="9"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
