<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIApp.Views.CpuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIApp.Controls"
    xmlns:vm="using:WinUIApp.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">

            <TextBlock Text="CPU 详细监测" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- CPU 使用率曲线 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8" Padding="16"
                    BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CPU 使用率历史 (最近 60 秒)"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="24" Foreground="#FF0078D4"
                                       VerticalAlignment="Center" FontWeight="SemiBold"
                                       Text="{Binding Cpu.UsageText}" />
                        </StackPanel>
                    </Grid>
                    <controls:CpuHistoryChart
                        Height="200"
                        Data="{Binding Cpu.UsageHistory}"
                        DataCount="{Binding Cpu.HistoryCount}"
                        LineColor="#FF0078D4" />
                </StackPanel>
            </Border>

            <!-- CPU 详情 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8" Padding="16"
                    BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="处理器信息" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    <Grid ColumnSpacing="24" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="名称:" Grid.Row="0" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding Cpu.Name}" Grid.Row="0" Grid.Column="1" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="当前频率:" Grid.Row="0" Grid.Column="2"
                                   Foreground="{ThemeResource TextFillColorSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding Cpu.ClockSpeedText}" Grid.Row="0" Grid.Column="3" FontSize="12" />

                        <TextBlock Text="物理核心:" Grid.Row="1" Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding Cpu.CoreCount}" Grid.Row="1" Grid.Column="1" FontSize="12" />

                        <TextBlock Text="逻辑处理器:" Grid.Row="1" Grid.Column="2"
                                   Foreground="{ThemeResource TextFillColorSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding Cpu.LogicalProcessorCount}" Grid.Row="1" Grid.Column="3" FontSize="12" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 每核心使用率 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8" Padding="16"
                    BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="每核心使用率" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Cpu.PerCoreUsage}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CoreUsageItem">
                                <Grid Margin="0,3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="45" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               FontSize="11" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding UsagePercent}"
                                                 Maximum="100" VerticalAlignment="Center"
                                                 Foreground="#FF0078D4" />
                                    <TextBlock Grid.Column="2" Text="{Binding UsageText}"
                                               FontSize="10" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
