<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIApp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIApp.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
        <StackPanel Padding="24,8,24,32" Spacing="8" MaxWidth="1000" HorizontalAlignment="Center">

            <controls:PageHeader Style="{StaticResource PageHeaderStyle}" Eyebrow="工作区" Title="设置"
                                 Subtitle="所有更改立即生效，并在下次启动时沿用。偏好保存在本机用户配置目录中。"
                                 Margin="0,0,0,8" />

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Warning"
                     Title="当前更改已应用，但无法保存到本机。" />
            <InfoBar x:Name="StartupWarning" IsOpen="False" IsClosable="True" Severity="Warning"
                     Title="无法更新开机启动项。" />

            <!-- 外观 -->
            <TextBlock Text="外观" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="4,8,4,2" />

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE790;" Header="应用主题"
                                   Description="跟随 Windows 系统主题，或固定使用浅色 / 深色。">
                <ComboBox x:Name="ThemeSelector" MinWidth="150" SelectionChanged="OnSelectionChanged">
                    <ComboBoxItem Tag="System" Content="跟随系统" />
                    <ComboBoxItem Tag="Light" Content="浅色" />
                    <ComboBoxItem Tag="Dark" Content="深色" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE7F4;" Header="窗口材质"
                                   Description="Mica 让桌面壁纸柔和地透过窗口背景。系统不支持时自动回退为亚克力或纯色。">
                <ComboBox x:Name="BackdropSelector" MinWidth="150" SelectionChanged="OnSelectionChanged">
                    <ComboBoxItem Tag="Mica" Content="Mica" />
                    <ComboBoxItem Tag="Acrylic" Content="亚克力" />
                    <ComboBoxItem Tag="Solid" Content="纯色" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE895;" Header="动画效果"
                                   Description="页面切换与仪表盘的入场过渡。跟随系统时会自动尊重「显示动画」辅助功能设置。">
                <ComboBox x:Name="MotionSelector" MinWidth="150" SelectionChanged="OnSelectionChanged">
                    <ComboBoxItem Tag="System" Content="跟随系统" />
                    <ComboBoxItem Tag="Full" Content="始终开启" />
                    <ComboBoxItem Tag="Off" Content="关闭" />
                </ComboBox>
            </controls:SettingsCard>

            <!-- 窗口 -->
            <TextBlock Text="窗口" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="4,16,4,2" />

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE718;" Header="窗口置顶"
                                   Description="让监测窗口始终位于其他窗口之上。">
                <ToggleSwitch x:Name="PinSwitch" OnContent="开" OffContent="关" Toggled="OnSettingToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE740;" Header="启动时最大化"
                                   Description="下次启动时以最大化窗口打开监测界面。">
                <ToggleSwitch x:Name="MaximizeSwitch" OnContent="开" OffContent="关" Toggled="OnSettingToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE713;" Header="记住窗口大小"
                                   Description="退出时保存当前窗口尺寸，下次启动时恢复。">
                <ToggleSwitch x:Name="RememberSizeSwitch" OnContent="开" OffContent="关" Toggled="OnSettingToggled" />
            </controls:SettingsCard>

            <!-- 采样 -->
            <TextBlock Text="数据采样" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="4,16,4,2" />

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE823;" Header="刷新间隔"
                                   Description="CPU、内存和网络按此间隔采样；磁盘与进程信息至少间隔 5 秒更新，以降低开销。">
                <ComboBox x:Name="IntervalSelector" MinWidth="130" SelectionChanged="OnSelectionChanged">
                    <ComboBoxItem Tag="1" Content="1 秒" />
                    <ComboBoxItem Tag="2" Content="2 秒" />
                    <ComboBoxItem Tag="5" Content="5 秒" />
                    <ComboBoxItem Tag="10" Content="10 秒" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE9D2;" Header="进程列表长度"
                                   Description="系统信息页显示的内存占用前 N 个进程。">
                <ComboBox x:Name="ProcessCountSelector" MinWidth="130" SelectionChanged="OnSelectionChanged">
                    <ComboBoxItem Tag="5" Content="5 个进程" />
                    <ComboBoxItem Tag="10" Content="10 个进程" />
                    <ComboBoxItem Tag="15" Content="15 个进程" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE916;" Header="进程与慢速指标刷新间隔"
                                   Description="进程列表、磁盘与系统信息的刷新频率。CPU、内存与网络始终按采样间隔更新。">
                <ComboBox x:Name="ProcessIntervalSelector" MinWidth="130" SelectionChanged="OnSelectionChanged">
                    <ComboBoxItem Tag="2" Content="2 秒" />
                    <ComboBoxItem Tag="5" Content="5 秒" />
                    <ComboBoxItem Tag="10" Content="10 秒" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE921;" Header="最小化时暂停采样"
                                   Description="窗口最小化时跳过采样以节省资源，恢复窗口后自动继续，历史数据保持不变。">
                <ToggleSwitch x:Name="PauseMinimizedSwitch" OnContent="开" OffContent="关"
                              Toggled="OnSettingToggled" />
            </controls:SettingsCard>

            <!-- 趋势图 -->
            <TextBlock Text="趋势图" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="4,16,4,2" />

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE81C;" Header="采样点数量"
                                   Description="趋势图保留的采样点数量。点数越多，曲线覆盖的时间窗口越长。">
                <ComboBox x:Name="CapacitySelector" MinWidth="130" SelectionChanged="OnSelectionChanged">
                    <ComboBoxItem Tag="30" Content="30 点" />
                    <ComboBoxItem Tag="60" Content="60 点" />
                    <ComboBoxItem Tag="120" Content="120 点" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE80A;" Header="显示网格线"
                                   Description="在趋势图上显示 0–100% 的水平参考网格与刻度。">
                <ToggleSwitch x:Name="GridSwitch" OnContent="开" OffContent="关" Toggled="OnSettingToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE9D5;" Header="面积填充"
                                   Description="使用强调色的渐变填充折线下方的区域，让趋势更易读。">
                <ToggleSwitch x:Name="AreaSwitch" OnContent="开" OffContent="关" Toggled="OnSettingToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE7BA;" Header="阈值参考线"
                                   Description="在趋势图上标出提醒阈值的位置，便于对照当前读数。">
                <ToggleSwitch x:Name="ThresholdLineSwitch" OnContent="开" OffContent="关"
                              Toggled="OnSettingToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE721;" Header="鼠标悬停读数"
                                   Description="鼠标在趋势图上移动时显示竖直参考线与对应采样点的数值。">
                <ToggleSwitch x:Name="TooltipSwitch" OnContent="开" OffContent="关"
                              Toggled="OnSettingToggled" />
            </controls:SettingsCard>

            <!-- 占用提醒 -->
            <TextBlock Text="占用提醒" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="4,16,4,2" />

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE950;" Header="CPU 高占用提醒"
                                   Description="CPU 使用率达到阈值时在窗口顶部显示提醒条，可随时关闭。">
                <ToggleSwitch x:Name="CpuAlertSwitch" OnContent="开" OffContent="关"
                              Toggled="OnAlertToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" x:Name="CpuThresholdCard" Icon="&#xE9D9;" Header="CPU 提醒阈值"
                                   Description="使用率高于此值时触发提醒。">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider x:Name="CpuThresholdSlider" Width="150" Minimum="50" Maximum="99"
                            StepFrequency="1" ValueChanged="OnThresholdChanged" />
                    <TextBlock x:Name="CpuThresholdText" MinWidth="42" VerticalAlignment="Center"
                               TextAlignment="Right" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE9D2;" Header="内存高占用提醒"
                                   Description="物理内存使用率达到阈值时在窗口顶部显示提醒条。">
                <ToggleSwitch x:Name="MemoryAlertSwitch" OnContent="开" OffContent="关"
                              Toggled="OnAlertToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" x:Name="MemoryThresholdCard" Icon="&#xE9D9;" Header="内存提醒阈值"
                                   Description="使用率高于此值时触发提醒。">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider x:Name="MemoryThresholdSlider" Width="150" Minimum="50" Maximum="99"
                            StepFrequency="1" ValueChanged="OnThresholdChanged" />
                    <TextBlock x:Name="MemoryThresholdText" MinWidth="42" VerticalAlignment="Center"
                               TextAlignment="Right" />
                </StackPanel>
            </controls:SettingsCard>

            <!-- 系统集成 -->
            <TextBlock Text="系统集成" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="4,16,4,2" />

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE7E8;" Header="开机时启动"
                                   Description="登录 Windows 后自动启动监测，写入当前用户的开机启动项，无需管理员权限。">
                <ToggleSwitch x:Name="StartupSwitch" OnContent="开" OffContent="关"
                              Toggled="OnStartupToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" x:Name="ConfigCard" Icon="&#xE8E5;" Header="配置文件"
                                   Description="preferences.json">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="打开所在文件夹" Click="OnOpenConfigFolder" />
                    <Button Content="复制路径" Click="OnCopyConfigPath" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard Style="{StaticResource SettingsCardStyle}" Icon="&#xE7A7;" Header="恢复默认设置"
                                   Description="把外观、采样、图表与提醒选项恢复为默认值，不影响已采集的数据。">
                <Button Content="恢复默认值" Click="OnResetDefaults" />
            </controls:SettingsCard>

            <!-- 关于 -->
            <Border Style="{StaticResource MonitorCardStyle}" Margin="0,12,0,0">
                <StackPanel Spacing="4">
                    <TextBlock Text="关于" Style="{StaticResource SectionHeaderTextBlockStyle}"
                               Margin="0,0,0,4" />
                    <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="应用" Value="System Monitor · WinUI 3" />
                    <controls:InfoRow Style="{StaticResource InfoRowStyle}" x:Name="AboutVersion" Label="版本" Value="—" />
                    <controls:InfoRow Style="{StaticResource InfoRowStyle}" x:Name="AboutRuntime" Label="运行时" Value="—" />
                    <controls:InfoRow Style="{StaticResource InfoRowStyle}" Label="数据来源" Value="Windows API 与 WMI 性能计数器" />
                    <HyperlinkButton Content="github.com/weepwood/WinUIApp-SystemMonitor"
                                     NavigateUri="https://github.com/weepwood/WinUIApp-SystemMonitor"
                                     Padding="0" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
