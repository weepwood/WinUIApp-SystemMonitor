<Page x:Class="WinUIApp.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16" MaxWidth="920" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="工作区" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="监测偏好" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="更改立即生效，下次启动时沿用。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Style="{StaticResource MonitorCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="外观与窗口" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox x:Name="ThemeSelector" Header="应用主题" MinWidth="180" SelectionChanged="OnSelectionChanged">
                        <ComboBoxItem Tag="System" Content="跟随系统" />
                        <ComboBoxItem Tag="Light" Content="浅色" />
                        <ComboBoxItem Tag="Dark" Content="深色" />
                    </ComboBox>
                    <ToggleSwitch x:Name="PinSwitch" Header="窗口置顶" OnContent="已置顶" OffContent="未置顶" Toggled="OnPinToggled" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MonitorCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="数据采样" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox x:Name="IntervalSelector" Header="刷新间隔" MinWidth="180" SelectionChanged="OnSelectionChanged">
                        <ComboBoxItem Tag="1" Content="1 秒" />
                        <ComboBoxItem Tag="2" Content="2 秒" />
                        <ComboBoxItem Tag="5" Content="5 秒" />
                    </ComboBox>
                    <TextBlock Text="CPU、内存和网络按所选间隔刷新；磁盘与进程信息至少间隔 5 秒更新。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <InfoBar x:Name="SaveWarning" Severity="Warning" IsClosable="False" Title="当前更改已应用，但无法保存到本机。" />
        </StackPanel>
    </ScrollViewer>
</Page>
