<Window x:Class="SystemMonitor.Lite.Dashboard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="系统监测 · Lite"
        Width="800" Height="690" MinWidth="540" MinHeight="440" Background="#F0F4F6"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#18313B" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/><Setter Property="BorderBrush" Value="#DAE5E8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="32"/>
            <Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F5F8F9"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF1F3"/><Setter Property="Foreground" Value="#375665"/>
            <Setter Property="Padding" Value="5,7"/>
        </Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="14,7"/></Style>
    </Window.Resources>
    <DockPanel Margin="18">
        <Border DockPanel.Dock="Top" Padding="20,15" Background="#193C46" CornerRadius="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SYSTEM MONITOR   /   LITE" Foreground="#8EDBCB" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="资源监测台" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="Device" Foreground="#DAE8EA"/>
            </StackPanel>
        </Border>
        <WrapPanel DockPanel.Dock="Top" Margin="2,3,2,12" VerticalAlignment="Center">
            <TextBlock Text="采样间隔" VerticalAlignment="Center"/>
            <ComboBox x:Name="Interval" SelectedIndex="1" Width="72" Margin="8,0,10,0" SelectionChanged="IntervalChanged" AutomationProperties.Name="采样间隔">
                <ComboBoxItem Tag="1">1 秒</ComboBoxItem><ComboBoxItem Tag="2">2 秒</ComboBoxItem><ComboBoxItem Tag="5">5 秒</ComboBoxItem>
            </ComboBox>
            <Button x:Name="Pause" Content="暂停采样" Click="TogglePause" Padding="10,3"/>
            <CheckBox Content="窗口置顶" Margin="14,0" VerticalAlignment="Center" IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="Status" AutomationProperties.AutomationId="SamplingStatus" Margin="4,10,0,0" Text="正在读取本机数据…"/>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="处理器 / CPU"/><TextBlock x:Name="CpuValue" Style="{StaticResource Metric}" Text="—"/>
                    <ProgressBar x:Name="CpuBar" Height="6" Foreground="#3685BE" Maximum="100"/>
                    <TextBlock x:Name="CpuDetail" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="物理内存 / RAM"/><TextBlock x:Name="RamValue" Style="{StaticResource Metric}" Text="—"/>
                    <ProgressBar x:Name="RamBar" Height="6" Foreground="#178678" Maximum="100"/>
                    <TextBlock x:Name="RamDetail" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,10,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="资源明细" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,8"/>
                    <TabControl>
                        <TabItem Header="内存前五"><DataGrid x:Name="Processes"><DataGrid.Columns>
                            <DataGridTextColumn Header="进程" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="75"/>
                            <DataGridTextColumn Header="工作集" Binding="{Binding SizeText}" Width="110"/>
                        </DataGrid.Columns></DataGrid></TabItem>
                        <TabItem Header="磁盘"><DataGrid x:Name="Drives"><DataGrid.Columns>
                            <DataGridTextColumn Header="驱动器" Binding="{Binding DriveName}" Width="*"/>
                            <DataGridTextColumn Header="可用 / 总量" Binding="{Binding Capacity}" Width="2*"/>
                            <DataGridTextColumn Header="读 / 写 (MiB/s)" Binding="{Binding Throughput}" Width="2*"/>
                        </DataGrid.Columns></DataGrid></TabItem>
                        <TabItem Header="网络"><DataGrid x:Name="Adapters"><DataGrid.Columns>
                            <DataGridTextColumn Header="网卡" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="下载" Binding="{Binding Download}" Width="95"/>
                            <DataGridTextColumn Header="上传" Binding="{Binding Upload}" Width="95"/>
                        </DataGrid.Columns></DataGrid></TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
